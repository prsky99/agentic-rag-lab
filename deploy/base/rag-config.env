# rag-config ConfigMap의 원본입니다. kustomization.yaml의 configMapGenerator가 이 파일을 읽어
# 이름 끝에 내용 해시가 붙은 ConfigMap(rag-config-<해시>)을 만들고, Deployment의 envFrom 참조도
# 같은 이름으로 바꿉니다. 값을 고쳐 `kubectl apply -k`만 다시 실행하면 파드 템플릿이 달라져
# 관련 Deployment가 롤링 재시작됩니다(환경 변수는 파드가 뜰 때만 읽기 때문입니다).
# 형식: KEY=값 한 줄씩. 값에 따옴표를 붙이지 않습니다. 주석은 줄 맨 앞의 #만 됩니다.
RETRIEVER_URL=http://retriever:8080
RERANKER_URL=http://reranker:8080
GENERATOR_URL=http://generator:8080
# 생성 서비스가 부를 LLM 주소(OpenAI 호환). 비우면 추출형 답변으로 대체합니다.
GENERATOR_UPSTREAM_URL=
GUARD_URL=http://guard:8080
# 하네스(llm.py)가 읽는 키. 비우면 프로세스 안 로컬 판정으로 돕니다.
DECISION_BASE_URL=http://decision:8000
QDRANT_URL=http://qdrant:6333
COLLECTION_ALIAS=docs_current
# local | qdrant. Qdrant에 색인한 뒤 qdrant로 바꿉니다(`make use-qdrant`가 색인 확인부터 합니다).
RETRIEVER_BACKEND=local
# 개발용 별칭. 운영에서는 비웁니다.
TENANT_ALIASES={"demo": ["acme"], "other": ["globex"]}
INDEX_SNAPSHOT=idx-2026-11-20
# 서비스 이미지에는 OTLP/HTTP 내보내기(opentelemetry-exporter-otlp-proto-http)만 들어 있으므로
# gRPC 4317이 아니라 HTTP 4318로 보냅니다. 끄려면 OTEL_SDK_DISABLED=true 줄을 더합니다.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1
MAX_QUESTION_CHARS=4000
MAX_REWRITES=1
